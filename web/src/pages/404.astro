---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" path="/404/">
  <main class="legal-main wrap-tight layer" style="text-align:center;">
    <div class="kicker" style="justify-content:center;">ERROR / 404</div>
    <h1 style="font-size:clamp(40px,8vw,80px); letter-spacing:-2px; margin-top:14px; line-height:1;">This page wandered off the calendar.</h1>
    <p class="lead" style="margin:18px auto 0; max-width:440px;">The page you're looking for isn't here.</p>
    <a class="btn btn--play" href="/" style="margin-top:28px; display:inline-flex;">Back to home</a>
  </main>
</Base>
