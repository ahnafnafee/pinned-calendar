---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" path="/404/">
  <section class="center">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>This page wandered off the calendar.</h1>
      <p class="lead center">The page you’re looking for doesn’t exist.</p>
      <p style="margin-top: 1.6rem;"><a class="btn btn-primary" href="/">Back to home</a></p>
    </div>
  </section>
</Base>
