---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" path="/404/">
  <main id="main" class="legal-main notfound">
    <div class="kicker">Error 404</div>
    <h1>This page wandered off the calendar.</h1>
    <p class="lead">The page you're looking for isn't here.</p>
    <a class="btn btn--filled" href="/">Back to home</a>
  </main>
</Base>
