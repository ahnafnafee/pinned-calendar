---
import Base from '../layouts/Base.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { APP_NAME, TAGLINE, PLAY_AVAILABLE } from '../config.mjs';
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-copy">
        <p class="eyebrow">Android · offline · open source</p>
        <h1>Your week, pinned.</h1>
        <p class="lead">
          {APP_NAME} keeps this week’s Google Calendar events and your to-dos in a single,
          self-healing notification — always one glance away. No sign-in, no internet, nothing
          ever leaves your phone.
        </p>
        <StoreButtons />
        <p class="note">
          {PLAY_AVAILABLE ? 'Free · no ads · no trackers.' : 'Free · no ads · no trackers · coming soon to Google Play.'}
        </p>
      </div>
      <div class="hero-art">
        <div class="phone">
          <img src="/shots/notification-light.png" width="320" height="713"
            alt="The Pinned Calendar notification showing this week’s agenda in the shade" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="features" id="features">
    <div class="wrap">
      <div class="center">
        <p class="eyebrow">Why you’ll keep it pinned</p>
        <h2>A calendar that meets you where you already look.</h2>
      </div>
      <div class="grid grid-2" style="margin-top: 2.6rem;">
        <article class="card">
          <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg></div>
          <h3>A self-healing pin</h3>
          <p>Swipe it away by accident and it quietly re-posts itself. Set it to Top, Normal, or Silent — Top sits above everything without ever buzzing or popping up.</p>
        </article>
        <article class="card">
          <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.6 8.95a1 1 0 0 1-.8 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.2-2.7a1 1 0 0 1 1.6 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg></div>
          <h3>Private by design</h3>
          <p>No <code>INTERNET</code> permission, no Google sign-in, no accounts, no analytics. It reads the calendars already synced on your device and nothing ever leaves it.</p>
        </article>
        <article class="card">
          <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 7 2 2 4-4"/><path d="m3 17 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/></svg></div>
          <h3>Events and to-dos, together</h3>
          <p>Add quick local to-dos and they merge into the same day-grouped agenda. Unfinished tasks carry forward until you’re done. Tap an event to open it in Google Calendar.</p>
        </article>
        <article class="card">
          <div class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.1 5.4L19.5 10l-5.4 1.6L12 17l-2.1-5.4L4.5 10l5.4-1.6z"/></svg></div>
          <h3>Material You, your way</h3>
          <p>Wallpaper-based dynamic color, seed colors, palette styles, AMOLED black, and selectable fonts. Light, dark, and system themes with an accent-adaptive icon.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- Screenshots -->
  <section id="screenshots">
    <div class="wrap">
      <div class="center">
        <p class="eyebrow">See it</p>
        <h2>One pin. Your whole week.</h2>
      </div>
      <div class="shots-grid" style="margin-top: 2.6rem;">
        <figure><img src="/shots/notification-light.png" width="320" height="713" loading="lazy" alt="Pinned agenda in light mode" /><figcaption>The pin, light</figcaption></figure>
        <figure><img src="/shots/notification-dark.png" width="320" height="713" loading="lazy" alt="Pinned agenda in dark mode" /><figcaption>The pin, dark</figcaption></figure>
        <figure><img src="/shots/todos.png" width="320" height="713" loading="lazy" alt="To-dos tab with week overview" /><figcaption>To-dos &amp; week view</figcaption></figure>
        <figure><img src="/shots/settings.png" width="320" height="713" loading="lazy" alt="Settings tab" /><figcaption>Settings</figcaption></figure>
      </div>
    </div>
  </section>

  <!-- Privacy callout -->
  <section class="callout" id="privacy">
    <div class="wrap">
      <div class="panel">
        <p class="eyebrow" style="color: var(--periwinkle);">Privacy</p>
        <h2>Your schedule never leaves your phone.</h2>
        <p>
          {APP_NAME} has no internet permission — it is technically incapable of sending anything
          off your device. It only ever asks for what it needs to show your agenda:
        </p>
        <ul class="perm-list">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><span><b>Calendar</b> — read the events already synced on your device.</span></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><span><b>Notifications</b> — show the pinned agenda.</span></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><span><b>Run at startup</b> — re-pin after a reboot.</span></li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg><span><b>Battery (optional)</b> — reliable background refresh.</span></li>
        </ul>
        <p style="margin-top: 1.4rem;"><a href="/privacy/" style="color:#fff; text-decoration: underline;">Read the full privacy policy →</a></p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section>
    <div class="wrap">
      <div class="center"><p class="eyebrow">Questions</p><h2>Good to know.</h2></div>
      <div class="faq-list" style="margin-top: 2.4rem;">
        <details class="faq-item"><summary>Does it need internet or a Google sign-in?</summary><p>No. The app has no internet permission and never signs in. It reads the calendars already synced on your device.</p></details>
        <details class="faq-item"><summary>Why did my pin come back after I swiped it?</summary><p>That’s by design — the pin is self-healing so an accidental swipe doesn’t lose your agenda. Turn it off in the app, or enable swipe-twice-to-remove.</p></details>
        <details class="faq-item"><summary>Will the pin drain my battery?</summary><p>No. There’s no foreground service; it refreshes in the background with WorkManager and updates instantly when your calendar changes.</p></details>
        <details class="faq-item"><summary>Is it really free?</summary><p>Yes — free, open source under the MIT License, with no ads and no trackers.</p></details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="wrap">
      <div class="panel">
        <img class="app-icon" src="/icon.png" width="76" height="76" alt="" />
        <h2>Pin your week in a tap.</h2>
        <p class="lead center">{TAGLINE}</p>
        <StoreButtons />
      </div>
    </div>
  </section>
</Base>
