---
import Base from '../layouts/Base.astro';
import { APP_NAME, GITHUB, RELEASES, PLAY_URL, PLAY_AVAILABLE, CONTACT_URL } from '../config.mjs';

const playHref = PLAY_AVAILABLE ? PLAY_URL : RELEASES;
const reps = Array.from({ length: 6 });
const shots = [
  { file: 'notification-dark.webp', alt: 'The pinned agenda in the notification shade, with this week grouped by day' },
  { file: '1.webp', alt: 'A to-do reminder in the shade with Mark done and Snooze actions' },
  { file: '2.webp', alt: 'The to-do list grouped into today, upcoming and completed' },
  { file: '3.webp', alt: 'The to-do sheet with schedule, repeat and priority options' },
  { file: 'settings-layout.webp', alt: 'Settings with a live preview of the notification layout' },
  { file: 'appearance.webp', alt: 'Appearance settings with Material You, accent colors and palettes' },
];

// The store mark takes the button's own text color so it keeps contrast in both schemes.
const PlaySvg = `<svg width="24" height="26" viewBox="0 0 24 26" fill="currentColor" aria-hidden="true"><path d="M2 2.2C1.6 2.5 1.4 3 1.4 3.7v18.6c0 .7.2 1.2.6 1.5l10.3-10.4L2 2.2z"/><path d="M16.4 9.1 12.3 13.4l4.1 4.3 4.6-2.6c1-.6 1-2 0-2.6l-4.6-3.4z" opacity=".75"/><path d="M2 2.2 12.3 13.4 16.4 9.1 4.4.9C3.6.4 2.7.7 2 2.2z" opacity=".9"/><path d="M12.3 13.4 2 23.8c.7 1.4 1.6 1.7 2.4 1.2l12-7z" opacity=".6"/></svg>`;

// Scalloped "cookie" outline, the same shape the app uses for its selected accent swatch.
const cookie = (() => {
  const lobes = 12, steps = 240, pts = [];
  for (let i = 0; i < steps; i++) {
    const t = (i / steps) * Math.PI * 2;
    const r = 44 + 4 * Math.cos(lobes * t);
    pts.push(`${(50 + r * Math.cos(t)).toFixed(2)} ${(50 + r * Math.sin(t)).toFixed(2)}`);
  }
  return `M${pts.join('L')}Z`;
})();
---

<Base>
  <!-- NAV -->
  <nav class="site-nav" aria-label="Primary">
    <div class="wrap row">
      <a class="brand" href="#top">
        <span class="ic"><img src="/app-icon.png" alt="Pinned Calendar" width="32" height="32" /></span>
        <span class="name">Pinned Calendar</span>
      </a>
      <div class="nav-links">
        <a href="#features">Features</a>
        <a href="#privacy">Privacy</a>
        <a class="btn btn--filled btn--sm" href="#get">Get the app</a>
      </div>
    </div>
  </nav>

  <span id="top"></span>

  <main id="main">

  <!-- HERO -->
  <section class="hero wrap-tight" aria-labelledby="hero-title">
    <div class="rise d1"><span class="chip">Agenda, always on</span></div>
    <h1 id="hero-title" class="rise d2">Your whole week, <br class="br-lg" /><span class="accent">pinned</span> where you'll <br class="br-lg" />actually see it.</h1>
    <p class="lead rise d3">This week's events and to-dos, kept right in your notification shade. One swipe down and it's there. No app to open, nothing in the cloud.</p>
    <div id="get" class="actions rise d4">
      <a class="btn btn--filled btn--store" href={playHref} target="_blank" rel="noopener">
        <Fragment set:html={PlaySvg} />
        <span class="btn-store-label"><small>Get it on</small><b>Google Play</b></span>
      </a>
      <a class="btn btn--tonal" href={GITHUB} target="_blank" rel="noopener">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-1.8c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
        View the source
      </a>
    </div>

    <!-- pinned phone -->
    <div class="phone-stage">
      <div class="phone-pin">
        <div class="phone-sway">
          <div class="phone">
            <div class="tack">
              <svg width="42" height="42" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="16" fill="var(--primary-container)"/><circle cx="24" cy="24" r="8" fill="var(--primary)"/></svg>
            </div>
            <div class="notif-screen">
              <div class="notif-status">
                <span>9:30</span>
                <span class="sys" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 4C7 4 2.7 6 0 9l12 15L24 9c-2.7-3-7-5-12-5z"/></svg><span class="notif-battery"></span></span>
              </div>
              <div class="notif-card">
                <div class="notif-head">
                  <span class="notif-app"><img src="/app-icon.png" alt="" width="36" height="36" /></span>
                  <div style="flex:1; min-width:0;">
                    <div class="notif-title">Pinned Calendar</div>
                    <div class="notif-sub">This week · 12</div>
                  </div>
                  <svg class="notif-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 15l6-6 6 6"/></svg>
                </div>
                <div class="notif-day">TODAY · WED 25</div>
                <div class="notif-rows">
                  <div class="notif-row" style="animation-delay:1.50s;"><span class="bar bar--teal"></span><span class="t">10:00 AM</span><span class="ev">Standup, cameras optional</span></div>
                  <div class="notif-row" style="animation-delay:1.62s;"><span class="bar bar--gray"></span><span class="t">11:00 AM</span><span class="ev">Reply to that 2019 email</span></div>
                  <div class="notif-row" style="animation-delay:1.74s;"><span class="bar bar--teal"></span><span class="t">1:00 PM</span><span class="ev">Pitch the moonshot idea</span></div>
                  <div class="notif-row" style="animation-delay:1.86s;"><span class="bar bar--teal"></span><span class="t">4:30 PM</span><span class="ev">Dentist (pretend I floss)</span></div>
                  <div class="notif-row" style="animation-delay:1.98s;"><span class="bar bar--amber"></span><span class="t">6:00 PM</span><span class="ev">Water the plants, they noticed</span></div>
                  <div class="notif-row" style="animation-delay:2.10s;"><span class="bar bar--blue"></span><span class="t">7:00 PM</span><span class="ev">Return the drill to Dana</span></div>
                </div>
                <div class="notif-more">+6 more this week</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FACTS -->
  <section class="facts" aria-label="At a glance" data-reveal>
    <ul class="wrap row" style="list-style:none; margin-block:0; padding:0;">
      <li class="fact"><b>0</b> accounts</li>
      <li class="fact"><b>100%</b> on-device</li>
      <li class="fact"><b>1</b> swipe to your week</li>
      <li class="fact"><b>Free</b>, no ads</li>
    </ul>
    <svg class="wave wrap" aria-hidden="true" focusable="false" height="14">
      <defs><pattern id="wave" width="56" height="14" patternUnits="userSpaceOnUse"><path d="M0 7Q14 -1 28 7T56 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></pattern></defs>
      <rect width="100%" height="14" fill="url(#wave)"/>
    </svg>
  </section>

  <!-- FEATURES -->
  <section id="features" class="section wrap-narrow">
    <div class="section-head" data-reveal>
      <div class="kicker">What makes it stick</div>
      <h2>A calendar that meets you where you already look.</h2>
    </div>
    <div class="cards">
      <article class="card" data-reveal>
        <div class="ic" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></div>
        <h3>Always-on agenda</h3>
        <p>A persistent, self-healing notification keeps this week's plan at the top of your shade, grouped by day. It rebuilds itself after reboots, so it is always current.</p>
      </article>
      <article class="card" data-reveal>
        <div class="ic" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="3"/><path d="M3 9h18M8 2v4M16 2v4M8.5 14.5l2 2 4-4"/></svg></div>
        <h3>Calendar and to-dos</h3>
        <p>Your real events and local to-dos sit side by side. Schedule optional alerts and build custom repeat rules with intervals, weekdays, or an ending.</p>
      </article>
      <article class="card" data-reveal>
        <div class="ic" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 9 8 11 4.6-2 8-6 8-11V5l-8-3z"/><path d="M9 12l2 2 4-4"/></svg></div>
        <h3>Private by default</h3>
        <p>No account, no analytics, no servers. The app reads your calendar on-device to build the notification and sends nothing, anywhere.</p>
      </article>
      <article class="card" data-reveal>
        <div class="ic" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3.2"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1"/></svg></div>
        <h3>Made yours</h3>
        <p>Material You theming, six accent colors, light or dark, AMOLED black, and a time window you control, from three days to two weeks.</p>
      </article>
    </div>
  </section>

  <!-- SHOWCASE -->
  <section class="section showcase" data-reveal>
    <div class="wrap-narrow section-head" style="margin-bottom:0;">
      <div class="kicker">A look inside</div>
      <h2>Clean, fast, and right where you need it.</h2>
    </div>
    <div class="wrap showcase-band"><div class="marquee-mask">
      <div class="marquee">
        {reps.map(() => shots.map((s) => <img src={`/shots/${s.file}`} width="224" height="500" loading="lazy" alt={s.alt} />))}
      </div>
    </div></div>
  </section>

  <!-- PRIVACY -->
  <section id="privacy" class="section wrap">
    <div class="privacy-block" data-reveal>
      <div class="kicker">Data handling</div>
      <h2>Your data never leaves your phone.</h2>
      <p>No sign-in. No analytics. No servers. Pinned Calendar builds the notification locally and keeps your to-dos and settings on your device only.</p>
      <div class="actions">
        <a class="btn btn--filled" href="/privacy/">Read the privacy policy</a>
        <a class="btn btn--text" href="/terms/">Terms of service</a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section wrap-tight final-cta">
    <div data-reveal>
      <div class="cookie" aria-hidden="true">
        <svg viewBox="0 0 100 100" focusable="false"><path d={cookie} /></svg>
        <img src="/app-icon.png" alt="" width="64" height="64" />
      </div>
      <h2>Pin your week today.</h2>
      <p class="lead">Free, open source, ready in seconds.</p>
      <a class="btn btn--filled btn--store" href={playHref} target="_blank" rel="noopener">
        <Fragment set:html={PlaySvg} />
        <span class="btn-store-label"><small>Get it on</small><b>Google Play</b></span>
      </a>
    </div>
  </section>
  </main>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="wrap top">
      <div class="blurb">
        <a class="brand" href="#top">
          <span class="ic"><img src="/app-icon.png" alt="Pinned Calendar" width="28" height="28" /></span>
          <span class="name">Pinned Calendar</span>
        </a>
        <p>Your week's events and to-dos, pinned to your notification shade. Private, local, and free.</p>
      </div>
      <div class="foot-cols">
        <div class="foot-col">
          <div class="h">Product</div>
          <a href="#features">Features</a>
          <a href="#get">Download</a>
          <a href={GITHUB} target="_blank" rel="noopener">Source code</a>
        </div>
        <div class="foot-col">
          <div class="h">Legal</div>
          <a href="/privacy/">Privacy Policy</a>
          <a href="/terms/">Terms of Service</a>
          <a href={CONTACT_URL} target="_blank" rel="noopener">Contact</a>
        </div>
      </div>
    </div>
    <div class="wrap colophon"><span>© 2026 {APP_NAME}. All rights reserved.</span></div>
  </footer>
</Base>
