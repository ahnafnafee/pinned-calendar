---
import Base from '../layouts/Base.astro';
import { APP_NAME, GITHUB, RELEASES, PLAY_URL, PLAY_AVAILABLE, CONTACT_URL } from '../config.mjs';

const playHref = PLAY_AVAILABLE ? PLAY_URL : RELEASES;
const reps = Array.from({ length: 6 });
const shots = ['1.png', '2.png', '3.png', 'notification-dark.png'];

const PlaySvg = `<svg width="24" height="26" viewBox="0 0 24 26" fill="none" aria-hidden="true"><path d="M2 2.2C1.6 2.5 1.4 3 1.4 3.7v18.6c0 .7.2 1.2.6 1.5l10.3-10.4L2 2.2z" fill="#E07F2C"/><path d="M16.4 9.1 12.3 13.4l4.1 4.3 4.6-2.6c1-.6 1-2 0-2.6l-4.6-3.4z" fill="#F8BC63"/><path d="M2 2.2 12.3 13.4 16.4 9.1 4.4.9C3.6.4 2.7.7 2 2.2z" fill="#F4A94E"/><path d="M12.3 13.4 2 23.8c.7 1.4 1.6 1.7 2.4 1.2l12-7z" fill="#E68235"/></svg>`;
---

<Base>
  <!-- NAV -->
  <nav class="site-nav layer">
    <div class="wrap row">
      <a class="brand" href="#top">
        <span class="ic"><img src="/app-icon.png" alt="Pinned Calendar" width="32" height="32" /></span>
        <span class="name">PINNED&nbsp;CALENDAR</span>
      </a>
      <div class="nav-links">
        <a href="#features">FEATURES</a>
        <a href="#privacy">PRIVACY</a>
        <a class="btn btn--cta" href="#get">GET&nbsp;THE&nbsp;APP</a>
      </div>
    </div>
  </nav>

  <span id="top"></span>

  <!-- HERO -->
  <header class="hero wrap-tight layer">
    <div class="kicker rise d1"><span class="sq"></span>AGENDA / ALWAYS ON</div>
    <h1 class="rise d2">Your whole week,<br /><span class="mark"><span>pinned</span><span class="mark-bg"></span></span> where you'll<br />actually see it.</h1>
    <p class="lead rise d3">This week's events and to-dos, kept right in your notification shade. One swipe down and it's there. No app to open, nothing in the cloud.</p>
    <div id="get" class="actions rise d4">
      <a class="btn btn--play" href={playHref} target="_blank" rel="noopener">
        <Fragment set:html={PlaySvg} />
        <span class="btn-store-label"><small>GET IT ON</small><b>Google Play</b></span>
      </a>
      <a class="btn btn--ghost" href={GITHUB} target="_blank" rel="noopener">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="#211C16" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-1.8c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>
        View the source
      </a>
    </div>

    <!-- pinned phone -->
    <div class="phone-stage">
      <div class="phone-shadow"></div>
      <div class="phone-pin">
        <div class="phone-sway">
          <div class="phone">
            <div class="tack">
              <svg width="42" height="42" viewBox="0 0 48 48" style="filter:drop-shadow(2px 4px 4px rgba(33,28,22,.4));"><circle cx="24" cy="24" r="15" fill="#211C16"/><circle cx="24" cy="24" r="6.4" fill="#E8843A"/><circle cx="20" cy="20" r="3" fill="#fff" opacity=".45"/></svg>
            </div>
            <div class="notif-screen">
              <div class="notif-status">
                <span>9:30</span>
                <span style="display:inline-flex; gap:6px; align-items:center;"><svg width="14" height="14" viewBox="0 0 24 24" fill="#c7ccd2"><path d="M12 4C7 4 2.7 6 0 9l12 15L24 9c-2.7-3-7-5-12-5z" opacity=".9"/></svg><span style="display:inline-block; width:22px; height:12px; border:1.5px solid #c7ccd2; border-radius:2px; position:relative;"><span style="position:absolute; inset:1.5px; background:#c7ccd2; border-radius:1px;"></span></span></span>
              </div>
              <div class="notif-card">
                <div class="notif-head">
                  <span class="notif-app"><svg width="21" height="21" viewBox="0 0 24 24" fill="none"><rect x="3" y="4.5" width="18" height="16.5" rx="3.2" fill="#5b6cff"/><rect x="3" y="4.5" width="18" height="5" rx="3.2" fill="#3f4fd6"/><rect x="7" y="2.4" width="2.4" height="5" rx="1.2" fill="#2c3899"/><rect x="14.6" y="2.4" width="2.4" height="5" rx="1.2" fill="#2c3899"/><circle cx="8" cy="13.5" r="1.5" fill="#fff"/><circle cx="12" cy="13.5" r="1.5" fill="#fff"/><circle cx="16" cy="13.5" r="1.5" fill="#fff"/><circle cx="8" cy="17.5" r="1.5" fill="#fff"/><circle cx="12" cy="17.5" r="1.5" fill="#fff"/></svg></span>
                  <div style="flex:1; min-width:0;">
                    <div class="notif-title">Pinned Calendar</div>
                    <div class="notif-sub">THIS WEEK · 10</div>
                  </div>
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#7c828b" stroke-width="2.4" stroke-linecap="round"><path d="M6 15l6-6 6 6"/></svg>
                </div>
                <div class="notif-day">TODAY · THU 11</div>
                <div class="notif-rows">
                  <div class="notif-row" style="animation-delay:1.5s;"><span class="bar" style="background:#6b7280;"></span><span class="t">8:10</span><span class="ev">Water the plants</span></div>
                  <div class="notif-row" style="animation-delay:1.62s;"><span class="bar" style="background:#5b7cff;"></span><span class="t">9:30</span><span class="ev">Project sync</span></div>
                  <div class="notif-row" style="animation-delay:1.74s;"><span class="bar" style="background:#5b7cff;"></span><span class="t">13:00</span><span class="ev">Design review</span></div>
                  <div class="notif-row" style="animation-delay:1.86s;"><span class="bar" style="background:#4caf6e;"></span><span class="t">18:00</span><span class="ev">Throw recycling</span></div>
                </div>
                <div class="notif-more">+6 MORE THIS WEEK</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- STAT TICKER -->
  <section class="ticker layer" data-reveal>
    <div class="wrap row">
      <span class="stat"><b>0</b> ACCOUNTS</span>
      <span class="dot">●</span>
      <span class="stat"><b>100%</b> ON-DEVICE</span>
      <span class="dot">●</span>
      <span class="stat"><b>1</b> SWIPE TO YOUR WEEK</span>
      <span class="dot">●</span>
      <span class="stat"><b>FREE</b>, NO ADS</span>
    </div>
  </section>

  <!-- FEATURES -->
  <section id="features" class="section wrap-narrow layer">
    <div class="section-head" data-reveal>
      <div class="kicker">WHAT MAKES IT STICK</div>
      <h2>A calendar that meets you where you already look.</h2>
    </div>
    <div class="ledger">
      <div class="ledger-row" data-reveal>
        <div class="num">01</div>
        <div class="body"><h3>Always-on agenda</h3><p>A persistent, self-healing notification keeps this week's plan at the top of your shade, grouped by day. It rebuilds itself after reboots, so it is always current.</p></div>
        <div class="ic"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#211C16" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></div>
      </div>
      <div class="ledger-row" data-reveal>
        <div class="num">02</div>
        <div class="body"><h3>Calendar and to-dos</h3><p>Your real events and quick local to-dos sit side by side. Add a task due today in a single tap, check it off, and watch it leave the pin.</p></div>
        <div class="ic"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#211C16" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="3"/><path d="M3 9h18M8 2v4M16 2v4M8.5 14.5l2 2 4-4"/></svg></div>
      </div>
      <div class="ledger-row" data-reveal>
        <div class="num">03</div>
        <div class="body"><h3>Private by default</h3><p>No account, no analytics, no servers. The app reads your calendar on-device to build the notification and sends nothing, anywhere.</p></div>
        <div class="ic"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#211C16" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 5v6c0 5 3.4 9 8 11 4.6-2 8-6 8-11V5l-8-3z"/><path d="M9 12l2 2 4-4"/></svg></div>
      </div>
      <div class="ledger-row" data-reveal>
        <div class="num">04</div>
        <div class="body"><h3>Made yours</h3><p>Material You theming, six accent colors, light or dark, AMOLED black, and a time window you control, from three days to two weeks.</p></div>
        <div class="ic"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#211C16" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3.2"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1"/></svg></div>
      </div>
    </div>
  </section>

  <!-- SHOWCASE -->
  <section class="section layer" data-reveal style="overflow:hidden;">
    <div class="wrap-narrow section-head" style="margin-bottom:0;">
      <div class="kicker">A LOOK INSIDE</div>
      <h2>Clean, fast, and right where you need it.</h2>
    </div>
    <div class="marquee-mask">
      <div class="marquee">
        {reps.map(() => shots.map((s) => <img src={`/shots/${s}`} width="224" height="498" loading="lazy" alt="Pinned Calendar screenshot" />))}
      </div>
    </div>
  </section>

  <!-- PRIVACY -->
  <section id="privacy" class="section wrap layer">
    <div class="privacy-block" data-reveal>
      <div class="kicker">DATA HANDLING</div>
      <h2>Your data never leaves your phone.</h2>
      <p>No sign-in. No analytics. No servers. Pinned Calendar builds the notification locally and keeps your to-dos and settings on your device only.</p>
      <div class="actions">
        <a class="btn btn--ink" href="/privacy/">Read the privacy policy</a>
        <a class="btn btn--ink-outline" href="/terms/">Terms of service</a>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section wrap-tight layer final-cta">
    <div data-reveal>
      <h2>Pin your week today.</h2>
      <p class="lead">Free, open source, ready in seconds.</p>
      <a class="btn btn--play" href={playHref} target="_blank" rel="noopener">
        <Fragment set:html={PlaySvg} />
        <span class="btn-store-label"><small>GET IT ON</small><b>Google Play</b></span>
      </a>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="site-footer layer">
    <div class="wrap top">
      <div class="blurb">
        <a class="brand" href="#top">
          <span class="ic"><img src="/app-icon.png" alt="Pinned Calendar" width="28" height="28" /></span>
          <span class="name">PINNED CALENDAR</span>
        </a>
        <p>Your week's events and to-dos, pinned to your notification shade. Private, local, and free.</p>
      </div>
      <div class="foot-cols">
        <div class="foot-col">
          <div class="h">PRODUCT</div>
          <a href="#features">Features</a>
          <a href="#get">Download</a>
          <a href={GITHUB} target="_blank" rel="noopener">Source code</a>
        </div>
        <div class="foot-col">
          <div class="h">LEGAL</div>
          <a href="/privacy/">Privacy Policy</a>
          <a href="/terms/">Terms of Service</a>
          <a href={CONTACT_URL} target="_blank" rel="noopener">Contact</a>
        </div>
      </div>
    </div>
    <div class="wrap colophon"><span>© 2026 {APP_NAME.toUpperCase()}. ALL RIGHTS RESERVED.</span></div>
  </footer>
</Base>
