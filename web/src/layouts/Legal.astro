---
import Base from './Base.astro';
const { title, updated, path } = Astro.props;
---
<Base title={title} path={path}>
  <section class="legal">
    <div class="wrap">
      <h1>{title}</h1>
      {updated && <p class="updated">Last updated: {updated}</p>}
      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
</Base>

<style>
  .legal .wrap { max-width: 760px; }
  .legal h1 { font-size: clamp(2rem, 4vw, 2.8rem); }
  .updated { color: var(--faint); margin-top: -0.4rem; }
  .prose { font-size: 1.02rem; }
  .prose :global(h2) { font-size: 1.3rem; margin-top: 2rem; }
  .prose :global(p) { color: var(--muted); }
  .prose :global(ul) { color: var(--muted); padding-left: 1.2rem; display: grid; gap: 0.4rem; }
  .prose :global(a) { word-break: break-word; }
  .prose :global(strong) { color: var(--ink); }
</style>
