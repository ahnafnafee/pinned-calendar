---
import Base from './Base.astro';
const { title, kicker, updated, path, other } = Astro.props;
---
<Base title={title} path={path}>
  <nav class="site-nav legal-nav" aria-label="Primary">
    <div class="row">
      <a class="brand" href="/">
        <span class="ic"><img src="/app-icon.png" alt="" width="36" height="36" /></span>
        <span class="name">Pinned Calendar</span>
      </a>
      <a class="btn btn--tonal btn--sm" href="/"><span aria-hidden="true">←</span> Back to site</a>
    </div>
  </nav>

  <main id="main" class="legal-main">
    <div class="kicker">{kicker}</div>
    <h1>{title}</h1>
    <div class="legal-updated">Last updated: {updated}</div>
    <slot />
  </main>

  <footer class="legal-footer">
    <div class="row">
      <span>© 2026 Pinned Calendar</span>
      <span class="links">
        <a href="/">Home</a>
        <a href={other.href}>{other.label}</a>
      </span>
    </div>
  </footer>
</Base>
