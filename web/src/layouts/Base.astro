---
import '../styles/site.css';
import { SITE, APP_NAME, DESCRIPTION, GITHUB, RELEASES } from '../config.mjs';

const { title, description = DESCRIPTION, path = '/' } = Astro.props;
const pageTitle = title ? `${title} · ${APP_NAME}` : `${APP_NAME}: your week, pinned`;
const canonical = new URL(path, SITE).href;
const ogImage = new URL('/og-image.png', SITE).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: APP_NAME,
  operatingSystem: 'Android 8.0+',
  applicationCategory: 'ProductivityApplication',
  description: DESCRIPTION,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  url: SITE + '/',
  downloadUrl: RELEASES,
  sameAs: [GITHUB],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={APP_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#19120d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fff8f5" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght,ROND@6..144,1..1000,0..100&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <slot />
    </div>
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window) || !els.length) {
          els.forEach(function (el) { el.classList.add('in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -5% 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var metas = document.querySelectorAll('meta[name="theme-color"]');
        var original = Array.prototype.map.call(metas, function (m) { return m.content; });
        // A forced theme overrides the media-keyed tags; read the live page color so no hex is repeated here.
        function syncMeta() {
          var forced = root.getAttribute('data-theme');
          var color = forced ? getComputedStyle(document.body).backgroundColor : null;
          Array.prototype.forEach.call(metas, function (m, i) { m.content = color || original[i]; });
        }
        var current = root.getAttribute('data-theme') || 'system';
        document.querySelectorAll('input[name="theme"]').forEach(function (input) {
          input.checked = input.value === current;
          input.addEventListener('change', function () {
            try {
              if (input.value === 'system') { root.removeAttribute('data-theme'); localStorage.removeItem('theme'); }
              else { root.setAttribute('data-theme', input.value); localStorage.setItem('theme', input.value); }
            } catch (e) {
              if (input.value === 'system') root.removeAttribute('data-theme');
              else root.setAttribute('data-theme', input.value);
            }
            syncMeta();
          });
        });
        syncMeta();
      })();
    </script>
  </body>
</html>
