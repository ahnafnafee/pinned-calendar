---
import { APP_NAME, TAGLINE, GITHUB, ISSUES, RELEASES } from '../config.mjs';
const year = 2026;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="brand-col">
      <a class="brand" href="/">
        <img src="/icon.png" alt="" width="30" height="30" />
        {APP_NAME}
      </a>
      <p>{TAGLINE} Offline, open source, and yours.</p>
    </div>
    <div>
      <h4>Product</h4>
      <ul>
        <li><a href="/#features">Features</a></li>
        <li><a href="/#screenshots">Screenshots</a></li>
        <li><a href={RELEASES} target="_blank" rel="noopener">Download</a></li>
      </ul>
    </div>
    <div>
      <h4>More</h4>
      <ul>
        <li><a href={GITHUB} target="_blank" rel="noopener">GitHub</a></li>
        <li><a href={ISSUES} target="_blank" rel="noopener">Report an issue</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
      </ul>
    </div>
  </div>
  <div class="colophon">
    <div class="wrap">
      <span>© {year} {APP_NAME}. Released under the MIT License.</span>
      <span>Not affiliated with Google. “Google Calendar” is a trademark of Google LLC.</span>
    </div>
  </div>
</footer>
